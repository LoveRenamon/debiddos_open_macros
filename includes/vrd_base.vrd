// Proceduralbones (worldmodel) (ref)
// This is a extremely lite version with minimal proceduralbone rules.
// I, don't have plans to share more presets. research yourself at Valve's human_sdk
// NOTE: use <basepos> as a tip of where is the ideal bone position

// Ulnas / Cúbitos
<helper> Bip01_L_Ulna Bip01_L_Forearm Bip01_L_Forearm Bip01_L_Hand
<basepos> 6 0 0
<trigger> 90 90 0 0 0 0 0 0 0 0
<trigger> 90 90 -90 0 0 0 0 0 0 0
<trigger> 90 90 90 0 0 0 0 0 0 0
<trigger> 90 0 0 -90 -45 0 0 0 0 0
<trigger> 90 0 0 90 -45 0 0 0 0 0
<trigger> 90 0 0 0 -45 0 0 0 0 0
<trigger> 90 180 0 0 45 0 0 0 0 0
<helper> Bip01_R_Ulna Bip01_R_Forearm Bip01_R_Forearm Bip01_R_Hand
<basepos> 6 0 0
<trigger> 90 -90 0 0 0 0 0 0 0 0
<trigger> 90 -90 90 0 0 0 0 0 0 0
<trigger> 90 -90 -90 0 0 0 0 0 0 0
<trigger> 90 0 0 -90 45 0 0 0 0 0
<trigger> 90 0 0 90 45 0 0 0 0 0
<trigger> 90 0 0 0 45 0 0 0 0 0
<trigger> 90 180 0 0 -45 0 0 0 0 0

// Punhos
<helper> Bip01_L_Wrist Bip01_L_Forearm Bip01_L_Forearm Bip01_L_Hand
<basepos> 10 0 0
<trigger> 90 90 0 0 0 0 0 0 0 0
<trigger> 90 90 -90 0 0 0 0 0 0 0
<trigger> 90 90 90 0 0 0 0 0 0 0
<trigger> 90 0 0 -90 -90 0 0 0 0 0
<trigger> 90 0 0 90 -90 0 0 0 0 0
<trigger> 90 0 0 0 -90 0 0 0 0 0
<trigger> 90 180 0 0 90 0 0 0 0 0
<helper> Bip01_R_Wrist Bip01_R_Forearm Bip01_R_Forearm Bip01_R_Hand
<basepos> 10 0 0
<trigger> 90 -90 0 0 0 0 0 0 0 0
<trigger> 90 -90 90 0 0 0 0 0 0 0
<trigger> 90 -90 -90 0 0 0 0 0 0 0
<trigger> 90 0 0 -90 90 0 0 0 0 0
<trigger> 90 0 0 90 90 0 0 0 0 0
<trigger> 90 0 0 0 90 0 0 0 0 0
<trigger> 90 180 0 0 -90 0 0 0 0 0
