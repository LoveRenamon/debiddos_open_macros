/*
	Bellow jigglebones are designed to use at breasts, butts and other often bouncy jiggles.
	Unless stated, all jigglebone properties have been made and checked by Debiddo.

	TIP:
				X = Pitch/Left
				Y = Yaw/Up
				Z = Along/Front

		Macros made by Davi (Debiddo) Gooz
*/


/*
	This kind of jiggle follows a purun-purun-like type of anime jiggle,
  not as distracting as $BreastPurun
	made in Nikolya's private commission "Nika" Akulova and Nataliya.

	TIP:
	 X-axis makes the up/down
	 Y-axis point forward the character
	 Z-axis must almost point to the ground, the more heavy it is, the more you align to character ribs

	Syntax:
*/
$definemacro BreastLarge BoneName \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		length 15 \\
		tip_mass 0 \\
		pitch_stiffness 50 \\
		pitch_damping 5 \\
		yaw_stiffness 50 \\
		yaw_damping 5 \\
		along_stiffness 50 \\
		along_damping 0 \\
		angle_constraint 15 \\
	} \\
} \\

/*
	In general, this is the type of breast that presents the best result for almost all cases,
	Not so "boing boing", not so "purun purun", however, correct positions is a must.

	TIP:
	 X-axis makes the up/down
	 Y-axis point forward the character
	 Z-axis must almost point to the ground, the more heavy it is, the more you align to character ribs

	Syntax:
*/
$definemacro BreastNatural BoneName \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		length 15 \\
		tip_mass 2 \\
		pitch_stiffness 44 \\
		pitch_damping 7 \\
		yaw_stiffness 44 \\
		yaw_damping 7 \\
		angle_constraint 14 \\
	} \\
	has_base_spring { \\
		base_mass 1 \\
		stiffness 255 \\
		damping 8 \\
		left_constraint -.15 .15 \\
		left_friction .01 \\
		up_constraint -.15 .15 \\
		up_friction .01 \\
		forward_constraint -.01 .01 \\
		forward_friction .05 \\
	} \\
} \\


/*
	This type of chest follows a purun purun (scales a scale) type of anime,
	it bouce/sways a lot and are distracting, often in an unwanted way.

	TIP:

	Syntax:
*/
$definemacro BreastPurun BoneName \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		yaw_stiffness 200 \\
		yaw_damping 9 \\
		pitch_stiffness 200 \\
		pitch_damping 9 \\
		length 20 \\
		angle_constraint 20 \\
	} \\
} \\


/*
	This type of jiggle has a kind of gelatinous movement (purun purun) from anime and eroge games,
	the bounce/swing can be very distracting and likey undesirable for most cases.

	TIP:

	Syntax:
*/
$definemacro ButtBouncy BoneName \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		length 10 \\
		tip_mass 10 \\
		pitch_stiffness 120 \\
		pitch_damping 4 \\
		yaw_stiffness 120 \\
		yaw_damping 4 \\
		allow_length_flex \\
		along_stiffness 100 \\
		along_damping 0 \\
		angle_constraint 15 \\
	} \\
	has_base_spring { \\
		base_mass 0 \\
		stiffness 100 \\
		damping 3 \\
		left_constraint -0.5 0.5 \\
		left_friction 0 \\
		up_constraint -0.5 0.5 \\
		up_friction 0 \\
		forward_constraint -0.5 0.5 \\
		forward_friction 0 \\
	} \\
} \\


/*
  Brincos
  Um mínimo detalhe que faz toda diferença.

  Esse Jiggle tem movimentos rápidos e balança cerca de três à quatro vezes antes de entrar em inércia.
  Foi escolhido "Earring" como nome do macro, pois o criei quando estava querendo um melhor movimento para brincos

	TIP:

	Syntax:
*/
$definemacro Earring BoneName \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		yaw_stiffness 100 \\
		yaw_damping 4 \\
		pitch_stiffness 100 \\
		pitch_damping 4 \\
		length 3 \\
		tip_mass 1 \\
		angle_constraint 33 \\
	} \\
} \\


/*
	Cauda originalmente composta de 3 bones que movem-se de forma suave em 10°

	TIP:

	Syntax:
*/
$definemacro Fluffy BoneName Angle \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		yaw_stiffness 64 \\
		yaw_damping 8 \\
		pitch_stiffness 64 \\
		pitch_damping 8 \\
		along_damping 10 \\
		length 10 \\
		tip_mass 1 \\
		angle_constraint $Angle$ \\
	} \\
} \\


/*
	Based on Zoey's holster

	TIP:

	Syntax:
	 $Holster jiggle_holster -3 3 -75 -15
*/
$definemacro Holster BoneName MinPitch MaxPitch YawMin YawMax \\
$jigglebone $BoneName$ { \\
	is_rigid { \\
		length 10 \\
		tip_mass 1000 \\
		pitch_friction 0 \\
		pitch_bounce 0 \\
		pitch_constraint $MinPitch$ $MaxPitch$ \\
		yaw_friction 0 \\
		yaw_bounce 1 \\
		yaw_constraint $YawMin$ $YawMax$ \\
	} \\
} \\


/*
  Jiggle Genéricos
  Normalmente são usados em cabelos e peças que precisam de algum balanço, mesmo que seja mínimo.

	TIP:

	Syntax:
*/


/*
	Almost a full modular macro for "is_flexible", useful for testing new presets

	TIP:

	Syntax:
	 $IsFlexibleAngle Prop_0  50  40  100 8  75 8  60 6  20
*/
$definemacro IsFlexibleAngle BoneName Mass Lengh PitchStiff PitchDamp YawStiff YawDamp AlongStiff AlongDamp Angle \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		angle_constraint $Angle$ \\
		tip_mass $Mass$ \\
		length $Lengh$ \\
		pitch_stiffness $PitchStiff$ \\
		pitch_damping $PitchDamp$ \\
		yaw_stiffness $YawStiff$ \\
		yaw_damping $YawDamp$ \\
		allow_length_flex \\
		along_stiffness $AlongStiff$ \\
		along_damping $AlongDamp$ \\
	} \\
} \\


/*
		A full modular macro for "is_flexible"

	TIP:

	Syntax:
	 $IsFlexiblePitchYaw Jiggle_0  50  40  100 8  75 8  60 6
*/
$definemacro IsFlexiblePitchYaw BoneName Mass Lengh PitchStiff PitchDamp YawStiff YawDamp AlongStiff AlongDamp PitchMin PitchMax YawMin YawMax \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		pitch_constraint -$Angle$ $Angle$ \\
		yaw_constraint -$Angle$ $Angle$ \\
		tip_mass $Mass$ \\
		length $Lengh$ \\
		pitch_stiffness $PitchStiff$ \\
		pitch_damping $PitchDamp$ \\
		yaw_stiffness $YawStiff$ \\
		yaw_damping $YawDamp$ \\
		allow_length_flex \\
		along_stiffness $AlongStiff$ \\
		along_damping $AlongDamp$ \\
	} \\
} \\


/*
	A even more modular macro for "is_flexible"

	TIP:

	Syntax:
	 $IsFlexiblePitchYaw Jiggle_0  50  40  100 8  75 8  60 6
*/
$definemacro IsFlexibleFull BoneName Mass Lenght PitchStiff PitchDamp PitchBounce YawStiff YawDamp YawBounce AlongStiff AlongDamp PitchMin PitchMax YawMin YawMax \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		pitch_constraint -$PitchMin$ $PitchMax$ \\
		yaw_constraint -$YawMin$ $YawMax$ \\
		tip_mass $Mass$ \\
		length $Lenght$ \\
		pitch_stiffness $PitchStiff$ \\
		pitch_damping $PitchDamp$ \\
		pitch_bounce $PitchBounce$ \\
		yaw_stiffness $YawStiff$ \\
		yaw_damping $YawDamp$ \\
		pitch_bounce $YawBounce$ \\
		allow_length_flex \\
		along_stiffness $AlongStiff$ \\
		along_damping $AlongDamp$ \\
	} \\
} \\


/*
	A even more modular macro for "is_flexible"

	TIP:

	Syntax:
*/
$definemacro IsFlexibleStiffDampBounceFric BoneName Mass Lenght PitchStiff PitchDamp PitchBounce PitchFriction YawStiff YawDamp YawBounce YawFriction AlongStiff AlongDamp PitchMin PitchMax YawMin YawMax \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		pitch_constraint -$PitchMin$ $PitchMax$ \\
		yaw_constraint -$YawMin$ $YawMax$ \\
		tip_mass $Mass$ \\
		length $Lenght$ \\
		pitch_stiffness $PitchStiff$ \\
		pitch_damping $PitchDamp$ \\
		pitch_bounce $PitchBounce$ \\
		pitch_friction $PitchFriction$ \\
		yaw_stiffness $YawStiff$ \\
		yaw_damping $YawDamp$ \\
		pitch_bounce $YawBounce$ \\
		pitch_friction $YawFriction$ \\
		allow_length_flex \\
		along_stiffness $AlongStiff$ \\
		along_damping $AlongDamp$ \\
	} \\
} \\


