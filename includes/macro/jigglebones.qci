/*
	Originalmente feito para ser usado nas Tiferets da Rosemon que fiz;
	Cada um dos ângulos por padrão eram 10°

	TIP:

	Syntax:
	 $Tiferet Prop_0 10 10 10
*/
$definemacro Tiferet BoneName AngleLeft AngleUp AngleForward \\
$jigglebone $BoneName$ { \\
	has_base_spring { \\
		stiffness 41 \\
		damping 6 \\
		base_mass 10 \\
		left_constraint -$AngleLeft$ $AngleLeft$ \\
		up_constraint -$AngleUp$ $AngleUp$ \\
		forward_constraint -$AngleForward$ $AngleForward$ \\
	} \\
} \\


/*
	Not actually used on Rosemon, but this also use "is_flexible" to gain even more movement

	TIP:

	Syntax:
	 $Tiferet2 Prop_0  -15 15  -15 15  10 10 10
*/
$definemacro Tiferet2 BoneName PitchMin PitchMax YawMin YawMax SpringAngleLeft SpringAngleUp SpringAngleForward \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		length 10 \\
		tip_mass 10 \\
		pitch_stiffness 120 \\
		pitch_damping 4 \\
		yaw_stiffness 120 \\
		yaw_damping 4 \\
		allow_length_flex \\
		along_stiffness 100 \\
		along_damping 0 \\
		pitch_constraint $PitchMin$ $PitchMax$ \\
		yaw_constraint $YawMin$ $YawMax$ \\
	} \\
	has_base_spring { \\
		stiffness 41 \\
		damping 6 \\
		base_mass 10 \\
		left_constraint -$SpringAngleLeft$ $SpringAngleLeft$ \\
		up_constraint -$SpringAngleUp$ $SpringAngleUp$ \\
		forward_constraint -$SpringAngleForward$ $SpringAngleForward$ \\
	} \\
} \\


/*
	Herrscher of Human: EGO Cloth jiggles (Left 4 Dead only!)

	TIP:

	Syntax:
*/
$definemacro HoHESilk BoneName MinPitch MaxPitch MinYaw MaxYaw \\
$JiggleBone $BoneName$ { \\
	is_flexible { \\
		length 20 \\
		tip_mass 333 \\
		pitch_stiffness 23 \\
		pitch_damping 6 \\
		pitch_friction .001 \\
		pitch_bounce 2 \\
		yaw_stiffness 23 \\
		yaw_damping 6 \\
		yaw_friction .001 \\
		yaw_bounce 1 \\
		along_stiffness 24 \\
		along_damping 6 \\
		allow_length_flex \\
		pitch_constraint $MinPitch$ $MaxPitch$ \\
		yaw_constraint $MinYaw$ $MaxYaw$ \\
	} \\
} \\


/*
	Herrscher of Flamescion Generic jiggles

	TIP:

	Syntax:
*/
$definemacro HoFBraid BoneName MinPitch MaxPitch MinYaw MaxYaw Angle \\
$jigglebone $BoneName$ { \\
	is_flexible { \\
		length 30 \\
		tip_mass 200 \\
		pitch_stiffness 50 \\
		pitch_damping 7 \\
		yaw_stiffness 50 \\
		yaw_damping 7 \\
		along_stiffness 100 \\
		along_damping 0 \\
		pitch_constraint $MinPitch$ $MaxPitch$ \\
		yaw_constraint $MinYaw$ $MaxYaw$ \\
		angle_constraint $Angle$ \\
	} \\
} \\
