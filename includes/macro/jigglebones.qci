		yaw_friction 0 \\
		yaw_bounce 0 \\
	} \\
} \\
$jigglebone $BoneName$2 { \\
	is_flexible { \\
		length 15 \\
		tip_mass 1000 \\
		pitch_constraint 0 20 \\
		pitch_friction 0 \\
		pitch_bounce 0 \\
		yaw_constraint -10 10 \\
		yaw_friction 0 \\
		yaw_bounce 0 \\
	} \\
} \\
$jigglebone $BoneName$3 { \\
	is_flexible { \\
		length 15 \\
		tip_mass 1000 \\
		pitch_constraint 0 25 \\
		pitch_friction 0 \\
		pitch_bounce 0 \\
		yaw_constraint -5 5 \\
		yaw_friction 0 \\
		yaw_bounce 0 \\
	} \\
} \\
$jigglebone $BoneName$4 { \\
	is_flexible { \\
		length 15 \\
		tip_mass 1000 \\
		pitch_constraint 0 30 \\
		pitch_friction 0 \\
		pitch_bounce 0 \\
		yaw_constraint -5 5 \\
		yaw_friction 0 \\
		yaw_bounce 0 \\
	} \\
} \\


