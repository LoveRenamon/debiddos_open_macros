/* Base
	Here follows the entire structure that is shared between playermodels (not survivors and infected), NPCs, and ragdolls to build a model. Many of these parameters are for QoL and better performance.

	It is possible to directly use this file as $include, but you will need to include $model, $body, and $bodygroups if applicable.

	But, Why?
		So that when I make an edit to an addon, it is shared with all the others, keeping them all updated with the same settings.

	NOTE: Using this absurd number of variables only works for Source2013 and similar;
	In others, due to some error, they mix or are ignored by StudioMDL.
*/
$zbrush
$upaxis "Z"
// if not defined, use below:
$definevariable _IN "../debiddos_open_macros/includes"

$definevariable eyex "1.77897"
$definevariable eyey "-0.78613"
$definevariable eyez "68.5638"

$definevariable IKHandLoc ".4"
$definevariable IKFootLoc ".5"
$definevariable IKHandFootRot ".05"

// Let's use our experimental macro index for $jigglebone, $sequence, and much more
$include $_IN$/macros.qci

// Here are our directories for materials ($cdmaterial)
$MODaMOD "" $Name$
$cdmaterials "shared"

$surfaceprop "flesh"
$contents "solid"

// Limits the eye angle by the value of this variable
$maxeyedeflection $eyedeflection$

// Eye position of the model when the engine needs to use something generic or is out of the players' view.
// The engine opts to save calculations of the "eyes" attachment and uses this fixed value.
$eyeposition 0 0 $eyez$

// Pivot position for calculating light interpolation
$illumposition 0 0 36

// Global position and scale for the model to be compiled (follows default values)
$origin 0 0 0 0
$scale 1.0

// For SMD, will force smoothing between each Shape Key / Flex in use
$forcephonemecrossfade

// Renders the model in two stages, first opaque and then transparency.
// This comes from an old technique to deal with gradients and alpha sorting.
$mostlyopaque

// Allows the model to receive Valve's workaround to increase model lighting in dark environments.
// Also called "cubemap boost."
$ambientboost

//$lockbonelengths    // Limits bone distances, but need to find the trigger (useful for custom animations only)
$collapsebones        // Any bone without weight and without $bonemerge will be deleted for performance

// Let's use the local $include from VProject to add each mesh;
// This allows reusing this "base.qci" for various Source 2013 projects.
// NOTE: if you gonna use $definebone QC command, call inside
$include "includes/mesh.qci"

// Always include proceduralbones for worldmodel (at least on wrists).
// Reference is in "vrd_base.vrd"; make a copy, rename it, and make your edits.
// TODO: Explain how to create your own proceduralbones list.
$proceduralbones "includes/proceduralbones.vrd"

// Minimum mandatory attachments
$include $_IN$/attachment.qci
//$attachment nose $Bone$Head1 0 -3 59 absolute
//$attachment mouth $Bone$Head1 0 -2.50656 64.9419 absolute
//$attachment amulet $Bone$Spine4 4.3 1.8 0 rotate 0 90 90
$attachment amulet $Bone$Spine4 4.3 1.8 0 rotate 0 90 90
$attachment hips $Bone$Pelvis 0 1.8 0 rotate -90 -90 0
$attachment chest  $Bone$Spine4 4 3 0 rotate 0 90 90
$attachment pouch1 $Bone$Pelvis 5.5 1 2 rotate -90 -90 0
$attachment pouch2 $Bone$Pelvis 6.5 0.5 -2 rotate -90 -90 0

// Additional attachments relative to your project
//$include "includes/attachment.qci"

// Control illumination boost for $ambientboost and cubemap
// As far as I've tested, works only in Left 4 Dead and Left 4 Dead 2
$keyvalues { AddedAmbientScale .05 }

// List of bones whose weight paint will be moved to the "parent" and discarded
$alwayscollapse "blender_implicit"

// Some people hardcode bone to be used instead of the attachment.
// If you want greater compatibility and don't need 1~3 additional bones, replace $alwayscollapse with $bonemerge.
//$alwayscollapse "ValveBiped.forward"
//$alwayscollapse "ValveBiped.Anim_Attachment_LH"
//$alwayscollapse "ValveBiped.Anim_Attachment_RH"

// Forces the below hierarchy. Both $heirarchy and $hierarchy parameters work. LOL.
// This is a workaround if your Pelvis is not the root for the compiler and you're working with skeletons from 3DS Max, XSI, or MikuMikuDance.
$hierarchy    $Bone$Pelvis   ""
$hierarchy    $Bone$L_Thigh  $Bone$Pelvis
$hierarchy    $Bone$R_Thigh  $Bone$Pelvis

// Used bone to move the character and tell which bone is the master bone when a child doesn't find it parent bone at import
$root         $Bone$Pelvis

$hierarchy    $Bone$Spine      $Bone$Pelvis
$hierarchy    $Bone$Spine1     $Bone$Spine
$hierarchy    $Bone$Spine2     $Bone$Spine1
$hierarchy    $Bone$Spine4     $Bone$Spine2
$hierarchy    $Bone$Neck1      $Bone$Spine4
$hierarchy    $Bone$Head1      $Bone$Neck1
$hierarchy    $Bone$L_Calf     $Bone$L_Thigh
$hierarchy    $Bone$L_Foot     $Bone$L_Calf
$hierarchy    $Bone$L_Toe0     $Bone$L_Foot
$hierarchy    $Bone$R_Calf     $Bone$R_Thigh
$hierarchy    $Bone$R_Foot     $Bone$R_Calf
$hierarchy    $Bone$R_Toe0     $Bone$R_Foot
$hierarchy    $Bone$L_Clavicle $Bone$Spine4
$hierarchy    $Bone$L_UpperArm $Bone$L_Clavicle
$hierarchy    $Bone$L_Forearm  $Bone$L_UpperArm
$hierarchy    $Bone$L_Hand     $Bone$L_Forearm
$hierarchy    $Bone$R_Clavicle $Bone$Spine4
$hierarchy    $Bone$R_UpperArm $Bone$R_Clavicle
$hierarchy    $Bone$R_Forearm  $Bone$R_UpperArm
$hierarchy    $Bone$R_Hand     $Bone$R_Forearm


// Forces the existence of these bones even if there's no WeightPaint / Skinning, as $bonemerge and $includemodel prevent the compiler from discarding them for automatic optimizations.
$include $_IN$/bonemerge.qci

/*
	Inverse Kinematics

	Usually, there is no need to edit $ikchains.
		IK "pelvis" is part of the legacy left by GoldSource and is no longer used.
*/
//$ikchain "pelvis" $Bone$Pelvis Z 0 knee .707 .707 0
$ikchain rhand $Bone$R_Hand knee .7 .7 -.1
$ikchain lhand $Bone$L_Hand knee .7 .7 -.1
$ikchain rfoot $Bone$R_Foot knee .7 -.7 0 radius 21 center 0 0 0
$ikchain lfoot $Bone$L_Foot knee .7 -.7 0 radius 21 center 0 0 0

/* This indicates a value of how much kinematics should be applied before any animation. 
	The first value is position and the second is rotation:
		"1" = 100%
		"0" = 0%
	It's possible to use negative values and values above 1.
*/
$ikautoplaylock rhand $IKHandLoc$ $IKHandFootRot$
$ikautoplaylock lhand $IKHandLoc$ $IKHandFootRot$
$ikautoplaylock rfoot $IKFootLoc$ $IKHandFootRot$
$ikautoplaylock lfoot $IKFootLoc$ $IKHandFootRot$

//$sequence "ragdoll" $ragdoll$ { activity "ACT_DIERAGDOLL" 1 fadein .337 fadeout .256 }
